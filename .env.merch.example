# Dedicated TEST credentials; do not reuse/replace the film payment variables.
# This backend explicitly rejects live Stripe keys and creates test-only orders.
MERCH_CHECKOUT_ENABLED=false
MERCH_STRIPE_SECRET_KEY=
MERCH_STRIPE_WEBHOOK_SECRET=
MERCH_SITE_ORIGIN=
# Reuse an isolated test Supabase project after applying docs/saints-merch-schema.sql.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional shipping rate for TEST checkout only; real shipping quote pending.
MERCH_STRIPE_SHIPPING_RATE_ID=
# Random server-only operator token, at least 32 characters.
MERCH_ADMIN_TOKEN=
# Keep off until separately reviewed production release; no dispatch endpoint here.
MERCH_FULFILLMENT_ENABLED=false
MERCH_SAMPLES_APPROVED=false
MERCH_APLIIQ_PROTOCOL_VERIFIED=false
APLIIQ_APP_ID=
APLIIQ_SHARED_SECRET=
# Saved APPROVED decorated-design SKUs from Apliiq, not bare-blank product codes.
MERCH_APLIIQ_NIX_S=
MERCH_APLIIQ_NIX_M=
MERCH_APLIIQ_NIX_L=
MERCH_APLIIQ_NIX_XL=
MERCH_APLIIQ_NIX_2XL=
MERCH_APLIIQ_NIX_3XL=
MERCH_APLIIQ_ROOK_S=
MERCH_APLIIQ_ROOK_M=
MERCH_APLIIQ_ROOK_L=
MERCH_APLIIQ_ROOK_XL=
MERCH_APLIIQ_ROOK_2XL=
MERCH_APLIIQ_ROOK_3XL=
