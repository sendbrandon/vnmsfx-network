{
  "cleanUrls": true,
  "trailingSlash": false,
  "framework": null,
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "www.vnmsfx.com" }],
      "destination": "https://vnmsfx.com/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.vnmsfx.com" }],
      "destination": "https://vnmsfx.com/:path*",
      "permanent": true
    },
    {
      "source": "/case-studies/sweet-vegan",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/case-studies/all-american-brad",
      "destination": "/studio",
      "permanent": true
    },
    {
      "source": "/case-studies/dreamina-ai",
      "destination": "/studio",
      "permanent": true
    },
    {
      "source": "/case-studies/:slug*",
      "destination": "/studio",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains" }
      ]
    }
  ]
}
